{
  "name": "wbp-sdk",
  "version": "1.0.0",
  "description": "The official SDK for integrating with the WorldBanksPi financial platform, WBP Token, and non-custodial WBP Payments on the Pi Network.",
  "main": "src/index.js",
  "module": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WorldBanksPi/WBP-SDK.git"
  },
  "keywords": [
    "pi-network",
    "pi",
    "worldbankspi",
    "wbp",
    "crypto",
    "sdk",
    "payments",
    "checkout",
    "blockchain"
  ],
  "author": "WorldBanksPi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WorldBanksPi/WBP-SDK/issues"
  },
  "homepage": "https://github.com/WorldBanksPi/WBP-SDK#readme",
  "dependencies": {
    "axios": "^1.0.0"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "docs"
  ]
}
